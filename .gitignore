.env
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.idea/
.vscode/

# Runtime-generated and private local state

# Microsoft OAuth token cache (defense in depth)
*msal_token_cache*.json
config/private/*
!config/private/.gitkeep
.env
*.token

# Runtime data: market caches, transactions, generated spreadsheets, status
# records, diagnostics, backups, and local scheduler state.
/data/assets/*
!/data/assets/.gitkeep
/data/backups/*
/data/diagnostics/
/data/intraday/*
/data/keep_awake_status.json
/data/migrations/*
/data/notifications/*
/data/schedule_status/*
/data/global/provider_state.json
/data/global/parameter_prompt_state.json
/data/global/run_status/*
/data/global/schedule_status/*
!/data/global/run_status/.gitkeep
/data/global/schedule_plans.json
/data/global/scheduled_tasks/*
!/data/global/scheduled_tasks/.gitkeep
!/data/intraday/.gitkeep
!/data/backups/.gitkeep
!/data/migrations/.gitkeep
!/data/notifications/.gitkeep
!/data/schedule_status/.gitkeep

# Generated reports and local logs.
/output/assets/*
!/output/assets/.gitkeep
/logs/*
!/logs/.gitkeep
!/logs/global/
/logs/global/*
!/logs/global/.gitkeep

# Versioned copies of the desktop shortcut icon are generated locally to force
# Explorer to refresh when the source ICO is replaced.
/scripts/windows/icons/generated/*
/scripts/windows/icons/*
!/scripts/windows/icons/generated/.gitkeep
!/scripts/windows/icons/.gitkeep
/tests/
/tests/*
