{
  "email": {
    "enabled": true,
    "provider": "microsoft_graph",
    "expected_sender": "followwhatyouwant@outlook.com",
    "recipient": "peterfla@163.com",
    "subject_prefix": "ETF Monitor",
    "send_mode": "trigger",
    "triggers": {
      "WAIT": false,
      "WATCH": true,
      "HOLD": false,
      "REVIEW_BUY": true,
      "PARTIAL_SELL": true
    },
    "include_llm_summary": true,
    "include_raw_metrics": true,
    "html": true,
    "debug": {
      "enabled": true,
      "force_send_email": true,
      "verbose_logging": true
    },
    "graph": {
      "authority": "https://login.microsoftonline.com/consumers",
      "scopes": [
        "Mail.Send"
      ],
      "endpoint": "https://graph.microsoft.com/v1.0/me/sendMail",
      "token_cache_file": "data/private/msal_token_cache.json",
      "timeout_seconds": 30,
      "save_to_sent_items": true
    }
  }
}
